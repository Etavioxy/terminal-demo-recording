[402.23796916007996,"o","\u001b[25l\u001b[6;1Hdef fib(n):\u001b[22X\r\n    if n <= 1:\u001b[19X\r\n        return n\u001b[17X\r\n    return fib(n-1) + fib(n-2)   \r\n\u001b[33X\r\n\u001b[33X\r\nfor i in range(10):\u001b[14X\r\n    print(f\"fib({i}) = {fib(i)}\")\u001b[15;1H\u001b[?25h"]
